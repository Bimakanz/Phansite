# Caddy (FrankenPHP) — bind 0.0.0.0 agar bisa diakses mesin lain di LAN
# Multithread: Caddy (Go) menangani request concurrent; PHP via worker pool.
{
	admin off
	auto_https off
}

:80 {
	root * /app/public
	encode gzip zstd

	# Static assets + Vite build: cache lama, immutable
	handle /build/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle /assets/* {
		header Cache-Control "public, max-age=86400"
		file_server
	}
	# Uploaded images via storage symlink
	handle /storage/* {
		header Cache-Control "public, max-age=86400"
		file_server
	}

	php_server
	log {
		output stderr
		format console
	}
}
