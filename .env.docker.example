# Env produksi Docker — Phansite (SQLite file, single container)
# GANTI APP_KEY dengan hasil `php artisan key:generate --show` dan APP_URL dengan IP LAN mesin ini.
APP_NAME=Phansite
APP_ENV=production
APP_DEBUG=false
APP_URL=http://192.168.1.10:28509
APP_KEY=base64:placeholder-ganti-dengan-hasil-php-artisan-key-generate-show

APP_LOCALE=en
APP_FALLBACK_LOCALE=en_US
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=sqlite
DB_DATABASE=/app/database/database.sqlite
DB_FOREIGN_KEYS=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public

# Worker/concurrency (Caddy multithread; 4 = jumlah CPU mesin)
PHP_CLI_SERVER_WORKERS=4
